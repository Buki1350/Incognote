# Auth service
JWT_SECRET=change_this_for_local_development_0123456789012345
JWT_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@incognote.local
ADMIN_PASSWORD=Admin1234
TRUSTED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,proton.me,protonmail.com,incognote.local

# Notes service
NOTE_ENCRYPTION_KEY=change_this_for_local_encryption_key_material
AUTH_SERVICE_URL=http://localhost:3001

# Shared
DATABASE_URL=postgres://postgres:postgres@localhost:5432/incognote

# SMTP (for email - verification, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM=Incognote <no-reply@incognote.local>
APP_BASE_URL=http://localhost:3000
