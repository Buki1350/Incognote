# Copy this file to .env on the Droplet and replace every change_this value.

# Public app settings
APP_PORT=80
APP_BASE_URL=http://YOUR_DROPLET_IP

# PostgreSQL container
POSTGRES_USER=incognote
POSTGRES_PASSWORD=change_this_postgres_password_2026
POSTGRES_DB=incognote

# Auth service
JWT_SECRET=change_this_jwt_secret_at_least_32_chars_2026
JWT_TTL_SECONDS=3600
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@incognote.local
ADMIN_PASSWORD=ChangeThisAdminPassword123
TRUSTED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,hotmail.com,live.com,yahoo.com,icloud.com,proton.me,protonmail.com,incognote.local

# Notes service
NOTE_ENCRYPTION_KEY=change_this_note_encryption_key_material_2026

# Optional email delivery for password reset / future mail flows
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Incognote <no-reply@incognote.local>"

# Optional login geolocation API
GEOIP_API_BASE_URL=https://ipapi.co

# Logs
RUST_LOG=auth-service=info,notes-service=info,tower_http=info
